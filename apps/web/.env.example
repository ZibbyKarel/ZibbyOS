NEXT_PUBLIC_API_URL=http://localhost:3333
# API base for pages opened from another host (e.g. the tailnet URL); optional
# NEXT_PUBLIC_REMOTE_API_URL=https://<host>.<tailnet>.ts.net:8443
# Canvas server origin (embedded pages at `<id>.canvas.localhost:<port>`); dev API port + 1
# NEXT_PUBLIC_CANVAS_URL=http://localhost:3334
# Canvas origin for remote pages: a second `tailscale serve` HTTPS port forwarded to the canvas port
# NEXT_PUBLIC_REMOTE_CANVAS_URL=https://<host>.<tailnet>.ts.net:8444
